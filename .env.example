# LeadGen v2 — worker fleet configuration.
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is the only env
# file that ships. Every variable here is read by something — see docs/ENV.md
# for which worker reads what and where each value comes from.
#
# Workers refuse to start when a variable they need is missing, and print the
# full list rather than dying on the first one. Optional variables degrade
# loudly at boot instead of silently at runtime.

# ═══════════════════════════════════════════════════════════════════════════
# Database
# ═══════════════════════════════════════════════════════════════════════════
# TWO connection strings, and they are not interchangeable.
#
# DATABASE_URL        → pgbouncer, transaction pooling. All application queries.
# DATABASE_URL_DIRECT → Supabase direct (port 5432), session mode.
#                       graphile-worker's LISTEN/NOTIFY only works here.
#
# Pointing both at the pooler is the single most likely misconfiguration: the
# queue will not crash, it will just silently stop waking on new jobs and fall
# back to polling. The workers assert this at boot and refuse to start.
#
# Supabase → Project Settings → Database → Connection string.
DATABASE_URL_DIRECT=postgresql://postgres:PASSWORD@db.YOURREF.supabase.co:5432/postgres

# Components pgbouncer needs to reach Supabase. Same credentials as above,
# split out because the pgbouncer image takes them as separate variables.
SUPABASE_DB_HOST=db.YOURREF.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres

# ═══════════════════════════════════════════════════════════════════════════
# Supabase API
# ═══════════════════════════════════════════════════════════════════════════
# Project Settings → API. The service role key bypasses RLS — workers only.
SUPABASE_URL=https://YOURREF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# Anthropic
# ═══════════════════════════════════════════════════════════════════════════
# console.anthropic.com → API keys. Used for owner extraction from crawled
# pages (claude-haiku-4-5-20251001). Without it, crawl/enrich still run but
# fall back to regex-only extraction.
ANTHROPIC_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# Decodo residential proxies
# ═══════════════════════════════════════════════════════════════════════════
# Decodo dashboard → Residential → endpoint + credentials.
# STICKY_TTL is how long one sticky session keeps the same exit IP; it must be
# longer than a single site crawl and a single LinkedIn session.
DECODO_USERNAME=
DECODO_PASSWORD=
DECODO_HOST=gate.decodo.com
DECODO_PORT=7000
DECODO_STICKY_TTL=600

# ═══════════════════════════════════════════════════════════════════════════
# Self-hosted services
# ═══════════════════════════════════════════════════════════════════════════
# Set by docker-compose; override only when running a worker outside compose.
SEARXNG_URL=http://searxng:8080
CRAWL4AI_URL=http://crawl4ai:11235
GOOGLE_MAPS_SCRAPER_URL=http://maps-scraper:8080

# SearXNG refuses to start without a secret. Generate: openssl rand -hex 32
SEARXNG_SECRET=

# ═══════════════════════════════════════════════════════════════════════════
# Google Places — FALLBACK ONLY
# ═══════════════════════════════════════════════════════════════════════════
# Discovery is gosom/google-maps-scraper now. This key is only used to resolve
# a place_id when the scraper cannot. Existing key from the v1 .env — ROTATE IT
# before reuse, it was in an unignored file.
GOOGLE_PLACES_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# Registries
# ═══════════════════════════════════════════════════════════════════════════
# Optional. Anonymous Socrata requests share a heavily throttled pool; a token
# raises the limit and is free. https://evergreen.data.socrata.com/signup
# (OpenCorporates has been dropped — its free API tier no longer exists.)
SOCRATA_APP_TOKEN=

# ═══════════════════════════════════════════════════════════════════════════
# Verification — verify-svc (self-hosted) + Verifalia (safety net)
# ═══════════════════════════════════════════════════════════════════════════
# verify-svc wraps AfterShip/email-verifier (MIT) and adds our per-MX throttle,
# IP rotation and 24h cooldown. It replaced Reacher, which is AGPL/commercial.
#
# VERIFY_IPS: comma-separated public IPs to send SMTP probes from. Each needs
#   PTR/rDNS pointing at VERIFY_HELO_DOMAIN, and SPF for that domain listing it.
# VERIFY_HELO_DOMAIN: a domain you own that is NOT a cold-email sending domain.
#   Burning its reputation must not affect your sending domains.
# VERIFY_FROM_EMAIL: the MAIL FROM address. Must be a real, deliverable mailbox
#   on VERIFY_HELO_DOMAIN — some servers verify the sender before answering RCPT.
VERIFY_URL=http://verify-svc:8080
VERIFY_IPS=92.112.184.200
VERIFY_HELO_DOMAIN=verify1.bezbuilder.com
VERIFY_FROM_EMAIL=verify@bezbuilder.com

# reacher | verifalia | hybrid   (default hybrid)
# 'reacher' is kept as an alias for the self-hosted provider so existing config
# does not break; it now routes to verify-svc.
VERIFIER=hybrid

# verifalia.com → Sub-accounts. The paid safety net: only sees unknown/risky
# verdicts on high-trust-name candidates, never safe or invalid.
VERIFALIA_USERNAME=
VERIFALIA_PASSWORD=
# Hard cap on Verifalia spend per campaign, in cents. On exhaustion the
# verify-svc verdict stands and the lead is flagged verifier_budget_exhausted.
VERIFALIA_MAX_CENTS_PER_CAMPAIGN=500

# ═══════════════════════════════════════════════════════════════════════════
# LinkedIn
# ═══════════════════════════════════════════════════════════════════════════
# Aged accounts, comma separated: email:password:li_at,email:password:li_at
# The li_at cookie may itself contain colons — only the first two separate the
# fields. Leave empty to run SERP-only LinkedIn discovery.
LINKEDIN_ACCOUNTS=

# ═══════════════════════════════════════════════════════════════════════════
# Runtime
# ═══════════════════════════════════════════════════════════════════════════
# WORKER_ROLE is set per-container by docker-compose; only set it here when
# running a worker directly.
# all | maps | serp | crawl | linkedin | registry | enrich | verify | scheduler
# WORKER_ROLE=all

WORKER_CONCURRENCY=5
LOG_LEVEL=info
METRICS_PORT=9100
